# External reference repos (cloned per-developer, not vendored)
reference/*/

# log2timeline.py drops a rotating *.log.gz in CWD on every invocation
log2timeline-*.log.gz

# Runtime case data — real evidence, never committable
outputs/cases/*
!outputs/cases/.gitkeep
outputs/cases/*/extractions/
outputs/cases/*/extractions/**

# Cross-case DuckDB stays out (regenerable + would re-introduce the
# excluded extractions inline).
outputs/*.duckdb
outputs/*.duckdb.wal
outputs/*.duckdb.tmp
outputs/*.duckdb.bak.*

# Go build artifacts
/bin/
/dist/
*.exe
*.test
*.out
vendor/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / editor
.vscode/
.idea/
*.swp
*~
.DS_Store

# Secrets / local config
*.local.yaml
.env
.env.local

# Logs
*.log

# Plaso intermediate storage. psteal.py / log2timeline.py drop
# <TIMESTAMP>-<source-basename>.plaso in CWD when not given a workspace-scoped
# `-w`; interactive srum_parser dev runs at the repo root left 19 of these
# behind by 2026-05-19 (Wave 20d cleanup). All intermediate, never committable.
*.plaso
libSQLite.Interop.so
/tlvb

# Claude Code session artefacts. scheduled_tasks.lock is a runtime
# cron lock; worktrees/ contains sibling-session embedded git repos.
# Neither belongs in this tree.
.claude/scheduled_tasks.lock
.claude/worktrees/

# Internal dev / process docs — excluded from the public release. These are
# planning notes, status trackers, internal QA test sheets, hackathon-prep
# drafts and AI-agent config that have no value to a public reader. Kept in
# private branches/history only.
docs/HACKATHON_GAP.md
docs/SESSION_HANDOFF.md
docs/STATUS.md
docs/IMPROVEMENTS.md
docs/valhuntir_analysis.md
docs/DEVPOST.md
docs/DEMO_SCRIPT.md
docs/TEST_*.md
docs/TEST_FEATURES.csv
/CLAUDE.md
/.session-board
/.claude/settings.json
reference/README.md
